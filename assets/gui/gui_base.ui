                <string notr="true">QComboBox {
    background-color: #E5F1FF; /* Цвет фона */
    color: #000000;          /* Цвет текста */
    border: 0px solid #E5F1FF; /* Рамка */
    border-radius: 20px;       /* Скругленные углы */
    padding: 5px;            /* Отступы */
}

QComboBox QAbstractItemView {
    border: 1px solid #C7E0FD;
    border-radius: 10px; /* Скругление выпадающего списка */
    selection-background-color: #C7E0FD; /* Цвет выделения */
    selection-color: black; /* Цвет текста выделенного элемента */
    padding: 5px;            /* Отступы */
    spacing: 5px;
    outline: none;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
    border-left: 0px solid #cccccc; /* Граница выпадающего списка */
}

QComboBox::down-arrow {
    image: url(gui/icons/arrow down.png); /* Замените на свой путь к картинке */
}</string>
